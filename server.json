{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.CynaCons/powerplan",
  "title": "powerplan",
  "description": "MCP server that makes PLAN.md the operational backbone of agentic development",
  "version": "0.7.0",
  "websiteUrl": "https://cynacons.github.io/powerplan/",
  "repository": {
    "url": "https://github.com/CynaCons/powerplan",
    "source": "github",
    "id": "1304953873"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "powerplan-mcp",
      "version": "0.7.0",
      "registryBaseUrl": "https://pypi.org",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1",
          "description": "Unbuffered stdio so MCP JSON-RPC flushes immediately."
        },
        {
          "name": "PYTHONIOENCODING",
          "value": "utf-8",
          "description": "UTF-8 stdio (needed on Windows)."
        }
      ]
    }
  ]
}
